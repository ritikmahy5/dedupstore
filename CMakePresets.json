{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug: -O0 -g, lock-order checker, test hooks",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS_DEBUG": "-O0 -g",
        "CMAKE_CXX_FLAGS_DEBUG": "-O0 -g",
        "DDS_ENABLE_TEST_HOOKS": "ON",
        "DDS_ENABLE_LOCK_ORDER_CHECK": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release: -O2 -g, the measured binary (no checker, no hooks)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS_RELEASE": "-O2 -g -DNDEBUG",
        "CMAKE_CXX_FLAGS_RELEASE": "-O2 -g -DNDEBUG"
      }
    },
    {
      "name": "asan",
      "displayName": "ASan + UBSan: -O1 -g, checker, test hooks",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS_DEBUG": "-O1 -g -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS_DEBUG": "-O1 -g -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "DDS_ENABLE_TEST_HOOKS": "ON",
        "DDS_ENABLE_LOCK_ORDER_CHECK": "ON"
      }
    },
    {
      "name": "tsan",
      "displayName": "ThreadSanitizer: -O1 -g, checker, test hooks",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS_DEBUG": "-O1 -g -fsanitize=thread",
        "CMAKE_CXX_FLAGS_DEBUG": "-O1 -g -fsanitize=thread",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
        "DDS_ENABLE_TEST_HOOKS": "ON",
        "DDS_ENABLE_LOCK_ORDER_CHECK": "ON"
      }
    },
    {
      "name": "fuzz",
      "displayName": "libFuzzer + ASan + UBSan (clang with libFuzzer only)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS_DEBUG": "-O1 -g -fsanitize=fuzzer-no-link,address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS_DEBUG": "-O1 -g -fsanitize=fuzzer-no-link,address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "DDS_ENABLE_TEST_HOOKS": "ON",
        "DDS_FUZZ": "ON",
        "DDS_BUILD_TESTS": "OFF",
        "DDS_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "tidy",
      "displayName": "Static checks: clang -Wthread-safety -Werror and clang-tidy",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS_DEBUG": "-O0 -g",
        "CMAKE_CXX_FLAGS_DEBUG": "-O0 -g",
        "DDS_ENABLE_TEST_HOOKS": "ON",
        "DDS_ENABLE_LOCK_ORDER_CHECK": "ON",
        "DDS_WERROR": "ON",
        "DDS_CLANG_TIDY": "ON",
        "DDS_BUILD_BENCHMARKS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz"
    },
    {
      "name": "tidy",
      "configurePreset": "tidy"
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "jobs": 8
      },
      "filter": {
        "exclude": {
          "label": "^slow$"
        }
      }
    },
    {
      "name": "slow",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "jobs": 4
      },
      "filter": {
        "include": {
          "label": "^slow$"
        }
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "inherits": "base",
      "configurePreset": "release"
    },
    {
      "name": "asan",
      "inherits": "base",
      "configurePreset": "asan",
      "environment": {
        "ASAN_OPTIONS": "abort_on_error=1:detect_stack_use_after_return=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "configurePreset": "tsan",
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1"
      }
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "tidy",
      "inherits": "base",
      "configurePreset": "tidy"
    },
    {
      "name": "debug-slow",
      "inherits": "slow",
      "configurePreset": "debug"
    },
    {
      "name": "asan-slow",
      "inherits": "slow",
      "configurePreset": "asan",
      "environment": {
        "ASAN_OPTIONS": "abort_on_error=1:detect_stack_use_after_return=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    },
    {
      "name": "tsan-slow",
      "inherits": "slow",
      "configurePreset": "tsan",
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1"
      }
    }
  ]
}
